import json
import urllib.request
import urllib.parse
import re
import sys
import os
import time


# --- CYBERPUNK THEME COLORS ---
CYAN = "\033[96m"
GREEN = "\033[92m"
MAGENTA = "\033[95m"
YELLOW = "\033[93m"
RED = "\033[91m"
RESET = "\033[0m"
BOLD = "\033[1m"

# The master dataset of official supported engines
SUPPORTED_PLATFORMS = {
    "youtube": "Full support (Videos, Shorts, YT Music, up to 4K)",
    "tiktok": "Full support (High-quality videos without watermarks)",
    "instagram": "Full support (Reels, Videos, IGTV, Photos)",
    "twitter": "Full support (Videos, Multi-image posts)",
    "x": "Full support (Videos, Multi-image posts)",
    "reddit": "Full support (Native videos & GIFs with audio)",
    "twitch": "Clips support available",
    "vimeo": "Full support (Up to 4K streams)",
    "bilibili": "Video and audio stream extraction supported",
    "dailymotion": "Full video and metadata extraction supported",
    "snapchat": "Public Spotlights and Stories supported",
    "soundcloud": "Direct raw audio file streaming supported",
    "pinterest": "Static photos, Story pins, and Video pins supported",
    "tumblr": "Embedded text-post videos and audio clips supported",
    "streamable": "Raw video streaming supported"
}

def show_banner():
    # Your custom ASCII art logo
    print(f"{CYAN}{BOLD}")
    print(r" _   _ _______  ___   _ ____  ")
    print(r"| \ | | ____\ \/ / | | / ___| ")
    print(r"|  \| |  _|  \  /| | | \___ \ ")
    print(r"| |\  | |___ /  \| |_| |___) |")
    print(r"|_| \_|_____/_/\_\\___/|____/ ")
    print(f"{MAGENTA}       ⚡ MOBILE DOWNLOADER v3.5 ⚡   ")
    print(f"{CYAN}=" * 35 + f"{RESET}\n")

def progress_hook(block_num, block_size, total_size):
    if total_size <= 0:
        return
    downloaded = block_num * block_size
    percent = min(100, int(downloaded * 100 / total_size))
    
    bar_length = 20
    filled_length = int(bar_length * percent // 100)
    bar = f"{GREEN}█{RESET}" * filled_length + f"{CYAN}░{RESET}" * (bar_length - filled_length)
    
    downloaded_mb = downloaded / (1024 * 1024)
    total_mb = total_size / (1024 * 1024)
    
    sys.stdout.write(
        f"\r{YELLOW}⚡ DOWNLOADING: [{bar}] {BOLD}{percent}%{RESET} ({downloaded_mb:.1f}/{total_mb:.1f} MB)"
    )
    sys.stdout.flush()

def clean_filename(title):
    return re.sub(r'[\\/*?:"<>|]', "", title)

def run_search_bar():
    while True:
        print("\033[H\033[J", end="") # Clear Screen
        show_banner()
        print(f"{CYAN}{BOLD}[ PLATFORM COMPATIBILITY DATABASE ]{RESET}\n")
        print(f"{YELLOW}Type a platform name to verify module integration.")
        print(f"Type 'exit' to head back to the Main Menu.{RESET}\n")
        
        query = input(f"{MAGENTA}🔍 SEARCH ➔ {RESET}").strip().lower()
        
        if query == 'exit':
            break
        elif not query:
            continue
            
        print("\n" + f"{CYAN}-" * 35 + f"{RESET}")
        
        matches = [key for key in SUPPORTED_PLATFORMS if query in key]
        
        if matches:
            for match in matches:
                print(f"{GREEN}[✔] MATCH FOUND: {BOLD}{match.upper()}{RESET}")
                print(f"    ↳ Status: {SUPPORTED_PLATFORMS[match]}")
        else:
            print(f"{RED}[✘] NO COMPATIBLE UPLINK FOUND FOR: '{query}'{RESET}")
            
        print(f"{CYAN}-" * 35 + f"{RESET}")
        input(f"\n{BOLD}Press ENTER to clear search and try again...{RESET}")

def mobile_download(video_url):
    print("\033[H\033[J", end="") 
    show_banner()
    print(f"{YELLOW}📡 Pinging backend matrix architecture...{RESET}")
    
    api_url = "https://api.cobalt.tools/api/json"
    data = json.dumps({"url": video_url}).encode('utf-8')
    
    req = urllib.request.Request(
        api_url, 
        data=data, 
        headers={
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'User-Agent': 'Mozilla/5.0'
        }
    )
    
    try:
        with urllib.request.urlopen(req) as response:
            res_data = json.loads(response.read().decode('utf-8'))
            
            if res_data.get('status') in ['stream', 'picker']:
                download_url = res_data.get('url')
                video_title = res_data.get('filename', 'video')
                filename = clean_filename(video_title) + ".mp4"
                
                print(f"\n{GREEN}[✔] TARGET CORRELATION ESTABLISHED!{RESET}")
                print(f"{MAGENTA}🎬 Title:{RESET} {BOLD}{video_title}{RESET}\n")
                
                urllib.request.urlretrieve(download_url, filename, reporthook=progress_hook)
                
                print(f"\n\n{GREEN}{BOLD}█" * 35)
                print(f"🎉 FILE SECURED INTO WORKSPACE SUCCESSFULLY 🎉")
                print(f"█" * 35 + f"{RESET}\n")
            else:
                print(f"\n{RED}[✘] ERROR: Core parsing failed. Check link visibility status.{RESET}")
                
    except Exception as e:
        print(f"\n{RED}[✘] CRITICAL REJECTION: Link handshaking failed.{RESET}")
        print(f"{YELLOW}Details: {e}{RESET}\n")
    
    input(f"{BOLD}Press ENTER to return to Main Menu...{RESET}")

if __name__ == "__main__":
    while True:
        print("\033[H\033[J", end="") # Clear layout screen
        show_banner()
        
        print(f"{BOLD}SELECT TASK INDEX:{RESET}")
        print(f"[{MAGENTA}1{RESET}] Download video from URL link")
        print(f"[{MAGENTA}2{RESET}] Launch Platform Search Database")
        print(f"[{MAGENTA}3{RESET}] Close Program\n")
        
        choice = input(f"{CYAN}➔ Terminal Command: {RESET}").strip()
        
        if choice == '1':
            print("\033[H\033[J", end="")
            show_banner()
            url = input(f"{MAGENTA}{BOLD}🔗 PASTE LINK HERE ➔ {RESET}")
            if url:
                mobile_download(url)
        elif choice == '2':
            run_search_bar()
        elif choice == '3':
            print(f"\n{YELLOW}Terminating session. Session Closed.{RESET}\n")
            break


time.slepp(1)
print("wait 1sec")
os.system("clear")